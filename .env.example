# ─── Klado — local installation template ────────────────────────────────────
# Copy this file to `.env` and fill it in. `.env` is git-ignored — never commit real
# values. Anything left blank falls back to the default in `api/core/config.py`.
#
# Klado runs entirely on this machine: the API and the SPA it serves, plus a local
# PostgreSQL. Nothing here talks to a hosted environment.

# ─── App ────────────────────────────────────────────────────────────────────
APP_NAME=Klado
APP_VERSION=0.1.0
APP_ENV=local
# Signs session cookies and derives the key that encrypts the stored mail password.
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ⚠️ Changing it later invalidates every session and makes a stored SMTP password
#    unreadable (the admin page will say so instead of failing mysteriously).
SECRET_KEY=change-me-to-a-random-string
# Serve the app from a sub-path instead of the root (e.g. /klado). Empty = "/".
APP_BASE_PATH=

# ─── Accounts ───────────────────────────────────────────────────────────────
# Klado's own account system. Keep AUTH_USER_INFO_URL and AUTH_TOOL_CODE EMPTY:
# their emptiness is what selects the local branch. Filling them in switches the app
# to an upstream SSO and silently disables every /api/auth endpoint.
AUTH_ENABLED=false
AUTH_USER_INFO_URL=
AUTH_TOOL_CODE=

# ⚠️ REQUIRED for a usable installation — this repository deliberately names nobody.
#   AUTH_ADMIN_EMAILS        Comma-separated administrators. The FIRST address is also
#                            the identity an unauthenticated request acts as while
#                            AUTH_ENABLED=false (local single-user mode, no login
#                            screen). Left empty there is NO implicit identity and
#                            every /api request answers 401 — that is the safe
#                            default, not a bug.
#   AUTH_ALLOWED_EMAIL_DOMAIN  Restrict sign-up and invitations to one domain.
#                            Blank accepts any well-formed address.
AUTH_ADMIN_EMAILS=
AUTH_ALLOWED_EMAIL_DOMAIN=

# First-admin bootstrap: create this account at startup from a pre-computed PBKDF2
# hash (never a plaintext password, so a repository reader learns nothing they can
# log in with). Needed mainly when mail is unconfigured — a verification code would
# otherwise only reach the server log.
#   cd api && ../.venv312/bin/python -c \
#     "from services.auth_store import _hash; print(_hash('your-password'))"
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_HASH=

AUTH_TIMEOUT_SECONDS=5
AUTH_CACHE_TTL_SECONDS=300
AUTH_CODE_TTL_SECONDS=600
AUTH_INVITE_TTL_SECONDS=1209600
AUTH_SESSION_TTL_SECONDS=2592000

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=klado
POSTGRES_USER=klado
POSTGRES_PASSWORD=change-me
# Refuse to guess when the database looks wrong instead of bootstrapping over it.
DB_BOOTSTRAP_STRICT=false

# ─── Registration / invitation mail (optional) ──────────────────────────────
# Normally configured from the admin page's "Mail delivery" card and stored encrypted
# in the `mail_settings` table — no restart, no file edit. These are the per-field
# fallback for an installation that would rather set them here.
# With both SMTP_HOST and SMTP_FROM blank nothing is emailed: a verification code is
# returned to the caller and stays readable on the admin page instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=ssl

# ─── Knowledge base ─────────────────────────────────────────────────────────
# 1 = reconcile api/knowledge_docs/*.md into the database at startup.
KNOWLEDGE_DOCS_AUTOAPPLY=1

# ─── AI providers (optional — AI analysis, OCR, report covers) ──────────────
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
VOLCENGINE_MODEL=ark-code-latest
VOLCENGINE_OCR_URL=https://visual.volcengineapi.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
# Model name each AI feature calls. A name routes to its provider's endpoint:
# `deepseek-*` → DeepSeek, `minimax*` → MiniMax, anything else → Volcengine.
# MINIMAX_IMAGE_MODEL is the report-cover image model; DOC_TOPIC_MODEL writes the
# 1–4 topic words a document gets. Unset = the built-in default in
# `api/services/llm_config.py`.
MINIMAX_IMAGE_MODEL=image-01
DOC_TOPIC_MODEL=deepseek-v4-flash

# ─── Document parsing (optional — structured extraction) ────────────────────
MINERU_API_TOKEN=
MINERU_API_BASE=https://mineru.net/api/v4

# ─── Object storage (optional — Data Center file library) ───────────────────
# Without this the Data Center file library reports "storage not configured";
# every other part of the app still works.
# Two interchangeable backends behind the same keys:
#   • Alibaba Cloud OSS (default) — leave OSS_S3_COMPAT empty.
#   • A self-hosted S3-compatible store (MinIO) — set OSS_S3_COMPAT=1, then point
#     OSS_ENDPOINT at it (e.g. http://localhost:9000). Alibaba's SDK cannot sign
#     requests for a plain S3 server, so that mode goes through boto3/SigV4.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET_NAME=
OSS_S3_COMPAT=
OSS_REGION=us-east-1

# ─── Admin console (api-admin/, a separate process on its own port) ──────────
# Start it with:  bash scripts/start_admin.sh
# The console and the main app share one PostgreSQL and one SECRET_KEY, and must NOT
# share a session cookie name: cookies are matched on host and ignore the port, so a
# shared name would have the two processes overwriting each other's login.
KLADO_ADMIN_PORT=8787
KLADO_ADMIN_SESSION_COOKIE=klado_admin_session
